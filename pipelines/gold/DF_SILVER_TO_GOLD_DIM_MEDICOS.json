{
    "name": "DF_SILVER_TO_GOLD_DIM_MEDICOS",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "DS_SILVER_MED_PLANTA",
                        "type": "DatasetReference"
                    },
                    "name": "srcsilvermedplanta"
                },
                {
                    "dataset": {
                        "referenceName": "DS_SILVER_RED_SEDES",
                        "type": "DatasetReference"
                    },
                    "name": "srcsilverredsedes"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "DS_GOLD_DIM_MEDICOS",
                        "type": "DatasetReference"
                    },
                    "name": "sinkdimmedicos"
                }
            ],
            "transformations": [
                {
                    "name": "jnmedicossedes"
                },
                {
                    "name": "drvdimmedicos"
                },
                {
                    "name": "sltdimmedicos"
                }
            ],
            "scriptLines": [
                "source(output(",
                "          med_id as integer,",
                "          esp_principal as string,",
                "          esp_secundaria as string,",
                "          id_sede as integer,",
                "          fec_ingreso as date,",
                "          tip_contrato as string,",
                "          jornada as string,",
                "          estado_activo as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false,",
                "     format: 'parquet') ~> srcsilvermedplanta",
                "source(output(",
                "          id_sede as integer,",
                "          nom_sede as string,",
                "          tip_sede as string,",
                "          id_ciudad as integer,",
                "          id_pais as integer,",
                "          cap_camas_gen as integer,",
                "          cap_camas_uci as integer,",
                "          cap_camas_cirugia as integer,",
                "          cap_camas_urg as integer,",
                "          nivel_complejidad as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false,",
                "     format: 'parquet') ~> srcsilverredsedes",
                "srcsilvermedplanta, srcsilverredsedes join(srcsilvermedplanta@id_sede == srcsilverredsedes@id_sede,",
                "     joinType:'left',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> jnmedicossedes",
                "jnmedicossedes derive(anos_experiencia = year(toDate('2026-08-17'))- year(fec_ingreso)) ~> drvdimmedicos",
                "drvdimmedicos select(mapColumn(",
                "          med_id,",
                "          esp_principal,",
                "          esp_secundaria,",
                "          id_sede = srcsilvermedplanta@id_sede,",
                "          fec_ingreso,",
                "          tip_contrato,",
                "          jornada,",
                "          estado_activo,",
                "          id_sede = srcsilverredsedes@id_sede,",
                "          nom_sede,",
                "          tip_sede,",
                "          id_ciudad,",
                "          id_pais,",
                "          cap_camas_gen,",
                "          cap_camas_uci,",
                "          cap_camas_cirugia,",
                "          cap_camas_urg,",
                "          nivel_complejidad,",
                "          anos_experiencia",
                "     ),",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true) ~> sltdimmedicos",
                "sltdimmedicos sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     format: 'parquet',",
                "     umask: 0022,",
                "     preCommands: [],",
                "     postCommands: [],",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true,",
                "     mapColumn(",
                "          med_id,",
                "          esp_principal,",
                "          esp_secundaria,",
                "          id_sede,",
                "          fec_ingreso,",
                "          tip_contrato,",
                "          jornada,",
                "          estado_activo,",
                "          nom_sede,",
                "          tip_sede,",
                "          id_ciudad,",
                "          id_pais,",
                "          cap_camas_gen,",
                "          cap_camas_uci,",
                "          cap_camas_cirugia,",
                "          cap_camas_urg,",
                "          nivel_complejidad,",
                "          anos_experiencia",
                "     )) ~> sinkdimmedicos"
            ]
        }
    }
}