{
    "name": "DF_SILVER_TO_GOLD_FACT_TIEMPOS_ESPERA",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "DS_SILVER_AGE_CITAS",
                        "type": "DatasetReference"
                    },
                    "name": "srcsilveragecitas"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "DS_GOLD_FACT_TIEMPOS_ESPERA",
                        "type": "DatasetReference"
                    },
                    "name": "sinkfacttiempoespera"
                },
                {
                    "dataset": {
                        "referenceName": "DS_ERRORS_AGE_CITAS",
                        "type": "DatasetReference"
                    },
                    "name": "sinkerroresagecitas"
                }
            ],
            "transformations": [
                {
                    "name": "drvfacttiemposespera"
                },
                {
                    "name": "splitfacttiemposespera"
                }
            ],
            "scriptLines": [
                "source(output(",
                "          id_cita as long,",
                "          pac_id as integer,",
                "          med_id as integer,",
                "          id_sede as integer,",
                "          fec_agendamiento as date,",
                "          fec_cita_programada as date,",
                "          hra_cita_programada as timestamp,",
                "          hra_llegada_paciente as timestamp,",
                "          hra_inicio_atencion as timestamp,",
                "          esp_solicitada as string,",
                "          tip_cita as string,",
                "          estado_cita as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false,",
                "     format: 'parquet') ~> srcsilveragecitas",
                "srcsilveragecitas derive(tiempo_espera_min = hra_inicio_atencion -hra_llegada_paciente) ~> drvfacttiemposespera",
                "drvfacttiemposespera split(upper(trim(estado_cita)) == 'ATENDIDA'\r",
                "&&\r",
                "!isNull(hra_llegada_paciente)\r",
                "&&\r",
                "tiempo_espera_min >= 0,",
                "     isNull(hra_llegada_paciente)\r",
                "||\r",
                "tiempo_espera_min < 0,",
                "     disjoint: false) ~> splitfacttiemposespera@(Validos, Errores)",
                "splitfacttiemposespera@Validos sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     format: 'parquet',",
                "     umask: 0022,",
                "     preCommands: [],",
                "     postCommands: [],",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true) ~> sinkfacttiempoespera",
                "splitfacttiemposespera@Errores sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     format: 'parquet',",
                "     umask: 0022,",
                "     preCommands: [],",
                "     postCommands: [],",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true) ~> sinkerroresagecitas"
            ]
        }
    }
}